# Copy to .env for local overrides. Never commit a real key.
PLUME_DATABASE_URL=postgresql+psycopg://plume:plume@127.0.0.1:18432/plume
PLUME_API_PORT=18480
PLUME_MCP_PORT=18481
# auto | hash | vertex | gemini
PLUME_EMBEDDER=auto
# PLUME_VERTEX_API_KEY=
# PLUME_GEMINI_API_KEY=
# Maintainer API tokens: JSON list, each at least 16 characters. Empty = maintainer API off.
# PLUME_MAINTAINER_TOKENS=["pl_change_me_to_a_long_random_token"]
# Folders with <api>.json gold sets for the quality gate.
# PLUME_GOLD_DIRS=["tests/fixtures/gold"]
# Server-side model generation (maintainers): a file holding the Vertex key; unset = off (503).
# PLUME_VERTEX_KEY_FILE=/run/secrets/vertex-api-key
# PLUME_MODEL_LLM=gemini-2.5-pro
# The web UI's base URL, for model share links (<url>/models/{id}).
# PLUME_WEB_PUBLIC_URL=http://127.0.0.1:18473
