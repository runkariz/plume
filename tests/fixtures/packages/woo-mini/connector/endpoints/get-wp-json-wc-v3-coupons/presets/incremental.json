{
  "configJson": {
    "ConfigType": 1,
    "CursorPaginationEnabled": false,
    "GetAllPages": false,
    "HeaderContractData": "{\"Authorization\":\"{{ auth?.apikey?.access_token ? auth.apikey.access_token : auth?.basic?.token }}\"}",
    "InheritsAuth": false,
    "ParamsContractData": "{\"per_page\":10,\"modified_after\":\"{{$date.addDays(sync_job.last_run_at,-1)}}\"}",
    "VariableContractData": "{\"host\":\"{{ auth?.apikey?.host }}\"}"
  },
  "description": "Updates the data-source by last sync date",
  "isPublicEntity": true,
  "name": "Incremental"
}
