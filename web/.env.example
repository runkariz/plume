# Base URL of the Plume HTTP API (no trailing slash). Required: there is no built-in default.
# Dev: the API's address. Deploy: leave it EMPTY (or "/") to call /v1 on the web's own origin (see README).
VITE_API_BASE_URL=http://127.0.0.1:18480
# Set to "true" to serve MSW mocks (sample data from the mockups) instead of the real API.
VITE_USE_MOCKS=true
